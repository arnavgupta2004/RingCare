RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=
# Sandbox OAuth token from the Ring developer console (valid 30 minutes)
RING_ACCESS_TOKEN=

# --- AWS (written by scripts/aws_setup.sh) ---
AWS_REGION=us-east-1
# sqlite (default) | dynamodb
STATE_BACKEND=sqlite
DYNAMODB_TABLE=doorsight-state
# local (default) | s3
SNAPSHOT_BACKEND=local
S3_BUCKET=
# Set to send caregiver alerts by email via SNS; empty = log to logs/notifications.log
SNS_TOPIC_ARN=
